<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">
<Configure class="org.eclipse.jetty.ee10.webapp.WebAppContext">
  <!--
    Exclude org.slf4j. from Jetty's default "system classes" so this
    webapp's own bundled slf4j-api + Logback (in WEB-INF/lib) are used
    directly, isolated from whatever the Jetty server itself is using
    internally, instead of being forced to share the container's copy.
    See docs/adr/0004-spring-was-jetty-replaces-netty.md.
  -->
  <Call name="addSystemClassMatcher">
    <Arg>
      <New class="org.eclipse.jetty.ee10.webapp.ClassMatcher">
        <Arg>
          <Array type="String">
            <Item>-org.slf4j.</Item>
          </Array>
        </Arg>
      </New>
    </Arg>
  </Call>
</Configure>
